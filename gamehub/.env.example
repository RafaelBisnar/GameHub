# Copy this file to .env and replace yourname with your DuckDNS subdomain.
# Restart `npx expo start` after changing it (values are read when bundling).
# These values end up inside the app, so never put passwords here.

# Base URL of the PHP API, without a trailing slash.
EXPO_PUBLIC_API_URL=https://yourname.duckdns.org/api

# Set to true only if the server rejects PATCH/DELETE requests (HTTP 405/403);
# the app then sends them as POST with an X-HTTP-Method-Override header.
EXPO_PUBLIC_API_METHOD_OVERRIDE=false
